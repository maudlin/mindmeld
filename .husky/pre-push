elif [[ "$branch" == *"major/"* || "$branch" == *"breaking/"* ]]; then
  echo "🔍 Breaking change branch detected: $branch"
  echo "📦 Auto-bumping major version for breaking changes..."
  npm run version:major
  
  # Stage and commit version changes
  git add package.json src/index.html
  git commit -m "chore: bump version for major release

