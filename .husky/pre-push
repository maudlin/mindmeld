#!/bin/bash

# Get current branch name
branch=$(git rev-parse --abbrev-ref HEAD)

# Smart version bumping for release-ready branches
if [[ "$branch" == *"feat/"* || "$branch" == *"feature/"* ]]; then
  echo "🔍 Feature branch detected: $branch"
  echo "📦 Auto-bumping minor version for new feature..."
  npm run version:minor
  
  # Stage and commit version changes
  git add package.json src/index.html
  git commit -m "chore: bump version for feature release

🤖 Generated with [Claude Code](https://claude.ai/code)" || true

elif [[ "$branch" == *"fix/"* || "$branch" == *"bugfix/"* ]]; then
  echo "🔍 Bugfix branch detected: $branch"
  echo "📦 Auto-bumping patch version for bugfix..."
  npm run version:patch
  
  # Stage and commit version changes
  git add package.json src/index.html
  git commit -m "chore: bump version for bugfix release

