elif [[ "$branch" == *"perf/"* || "$branch" == *"performance/"* ]]; then
  echo "🔍 Performance branch detected: $branch"
  echo "📦 Auto-bumping patch version for performance improvement..."
  npm run version:patch
  
  # Stage and commit version changes
  git add package.json src/index.html
  git commit -m "chore: bump version for performance release

