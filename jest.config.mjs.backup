// jest.config.mjs
/** @type {import('jest').Config} */
export default {
  clearMocks: true,
  testEnvironment: 'jsdom',

  // Keep unit tests isolated here
  roots: ['<rootDir>/tests/unit'],
  testMatch: ['**/*.test.js'],

  // Transform ES modules for Jest
  transform: {
    '^.+\\.js$': 'babel-jest',
  },

  // ---- Coverage you can trust ----
  collectCoverage: true,
  coverageProvider: 'v8',               // switch to 'babel' if needed for source maps
  collectCoverageFrom: [
    'src/js/**/*.js',
    '!src/**/__mocks__/**',
    '!**/*.test.js',
  ],
  coverageDirectory: 'coverage/unit',
  coverageReporters: ['text-summary', 'lcov', 'html'],
  coverageThreshold: {
    global: { lines: 80, statements: 80, functions: 80, branches: 80 },
    // Optional per-file tightening—for critical modules, ratchet higher:
    // './src/js/core/**/*.js': { lines: 90, statements: 90, functions: 90, branches: 85 },
  },

  // Keep e2e out explicitly (belt-and-braces)
  testPathIgnorePatterns: ['<rootDir>/tests/e2e/'],

  // Slightly faster, avoids noisy coverage from vendored deps
  coveragePathIgnorePatterns: ['/node_modules/', '/tests/'],
};
