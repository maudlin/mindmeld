{
  "name": "mindmeld",
  "version": "0.9.1",
  "description": "A web-based mind mapping tool",
  "main": "src/js/app.js",
  "type": "module",
  "scripts": {
    "start": "npm run version:sync && http-server src -p 8080 --cors",
    "version:sync": "node scripts/update-version.js",
    "changelog:generate": "node scripts/generate-changelog.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write 'src/**/*.{js,html,css}'",
    "format:all": "prettier --write '**/*.{js,html,css}' --ignore-path .prettierignore",
    "format:check": "prettier --check 'src/**/*.{js,html,css}'",
    "postinstall": "if [ \"$NODE_ENV\" != \"production\" ]; then playwright install chromium; fi",
    "test:unit": "if [ \"$NODE_ENV\" != \"production\" ]; then jest; else echo 'Skipping tests in production'; fi",
    "test:e2e": "if [ \"$NODE_ENV\" != \"production\" ]; then playwright test; else echo 'Skipping E2E tests in production'; fi",
    "test": "if [ \"$NODE_ENV\" != \"production\" ]; then npm run test:unit; else echo 'Skipping tests in production'; fi",
    "security": "eslint --config eslint.config.js src/ --rule 'security/*: error'",
    "security:fix": "eslint --config eslint.config.js src/ --fix",
    "prepare": "husky",
    "health-check": "./scripts/health-check.sh",
    "deps:check": "npx depcheck",
    "deps:update": "npx ncu --target minor",
    "deps:upgrade": "npx ncu --target minor -u && npm install",
    "analyze:circular": "npx madge --circular --extensions js src/",
    "analyze:complexity": "npx madge --summary src/",
    "analyze:duplication": "npx jscpd --min-lines=5 --min-tokens=50 src/",
    "fix": "npm run lint:fix && npm run format:all",
    "dev:setup": "npm run fix && npm run health-check",
    "pre-push": "npm run lint && npm run format:check && npm run test",
    "version:patch": "npm version patch --no-git-tag-version && npm run version:sync",
    "version:minor": "npm version minor --no-git-tag-version && npm run version:sync",
    "version:major": "npm version major --no-git-tag-version && npm run version:sync",
    "ci:simulate": "CI=true npm run lint && npm run format:check && npm run test:unit && npm run test:e2e"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@eslint/js": "^9.31.0",
    "@jest/globals": "^30.0.5",
    "@playwright/test": "^1.54.1",
    "depcheck": "^1.4.7",
    "eslint": "^9.31.0",
    "eslint-plugin-jest": "^28.14.0",
    "eslint-plugin-no-unsanitized": "^4.1.2",
    "eslint-plugin-playwright": "^1.8.3",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^15.15.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "jscpd": "^4.0.5",
    "lint-staged": "^16.1.2",
    "madge": "^8.0.0",
    "npm-check-updates": "^18.0.1",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "tests/**/*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "scripts/**/*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "nyc": {
    "check-coverage": true,
    "per-file": true,
    "lines": 80,
    "statements": 80,
    "functions": 80,
    "branches": 80
  }
}
