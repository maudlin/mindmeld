{
  "name": "mindmeld",
  "version": "0.6",
  "description": "A web-based mind mapping tool",
  "main": "src/js/app.js",
  "type": "module",
  "scripts": {
    "start": "http-server src -p 8080 --cors",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write 'src/**/*.{js,html,css}'",
    "format:check": "prettier --check 'src/**/*.{js,html,css}'",
    "postinstall": "playwright install chromium",
    "test:unit": "jest",
    "test:e2e": "playwright test",
    "test": "npm run test:unit",
    "security": "eslint --config eslint.config.js src/ --rule 'security/*: error'",
    "security:fix": "eslint --config eslint.config.js src/ --fix",
    "prepare": "husky"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.46.1",
    "babel-jest": "^29.7.0",
    "eslint": "^9.9.0",
    "eslint-plugin-jest": "^28.8.0",
    "eslint-plugin-no-unsanitized": "^4.1.2",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^15.9.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "lint-staged": "^16.1.2",
    "prettier": "^3.3.3"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "nyc": {
    "check-coverage": true,
    "per-file": true,
    "lines": 80,
    "statements": 80,
    "functions": 80,
    "branches": 80
  }
}
