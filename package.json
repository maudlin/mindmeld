{
  "name": "mindmeld",
  "version": "1.1.0",
  "description": "A web-based mind mapping tool",
  "main": "src/js/app.js",
  "type": "module",
  "scripts": {
    "start": "npm run version:sync && http-server src -p 8080 --cors",
    "version:sync": "node scripts/update-version.js",
    "changelog:generate": "node scripts/generate-changelog.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write 'src/**/*.{js,html,css}'",
    "format:all": "prettier --write '**/*.{js,html,css}' --ignore-path .prettierignore",
    "format:check": "prettier --check 'src/**/*.{js,html,css}'",
    "test:unit": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/smoke/",
    "test:e2e:integration": "playwright test --grep '@integration|@server-required'",
    "test:e2e:no-integration": "playwright test --grep-invert '@integration|@server-required'",
    "test:dev": "npm run test:unit && npm run test:e2e:no-integration",
    "test:dev:full": "npm run test:unit && npm run test:e2e",
    "test:ci": "npm run test:unit && npm run test:e2e:smoke",
    "test": "npm run test:dev",
    "e2e:instrument": "rm -rf .instrumented && BABEL_ENV=e2e-instrument babel src --out-dir .instrumented --extensions \".js\" --source-maps inline",
    "e2e:serve:instrumented": "http-server .instrumented -p 8080 --cors",
    "test:e2e:cov": "npm run e2e:instrument && PW_SERVER_CMD='npm run e2e:serve:instrumented' playwright test && nyc report --reporter=lcov --report-dir coverage/e2e --temp-dir coverage/e2e-raw",
    "coverage:merge": "lcov-result-merger 'coverage/**/lcov.info' > coverage/merged.lcov",
    "security": "eslint --config eslint.config.js src/ --rule 'security/*: error'",
    "security:fix": "eslint --config eslint.config.js src/ --fix",
    "prepare": "husky",
    "health-check": "./scripts/health-check.sh",
    "deps:check": "npx depcheck",
    "deps:update": "npx ncu --target minor",
    "deps:upgrade": "npx ncu --target minor -u && npm install",
    "analyze:circular": "npx madge --circular --extensions js src/",
    "analyze:complexity": "npx madge --summary src/",
    "ci:local": "echo '🚀 Running all CI checks locally...' && npm run lint && npm run format:check && npm run test:unit && npm run health-check && npm audit --audit-level=moderate && npm run security:semgrep && echo '✅ All CI checks passed!'",
    "security:semgrep": "semgrep --config=p/security-audit --config=p/javascript --config=p/owasp-top-ten --severity=ERROR --include=src --exclude=node_modules --exclude=dist --exclude=build --exclude=coverage --exclude=reports --exclude='**/*.map' --exclude='**/*.bundle.js' --exclude='**/*.min.js' --exclude='**/*.test.*' --exclude='**/*.spec.*' .",
    "analyze:duplication": "npx jscpd --min-lines=5 --min-tokens=50 src/",
    "fix": "npm run lint:fix && npm run format:all",
    "dev:setup": "npm run fix && npm run health-check",
    "pre-push": "npm run lint && npm run format:check && npm run test && npm run semgrep",
    "version:patch": "npm version patch --no-git-tag-version && npm run version:sync",
    "version:minor": "npm version minor --no-git-tag-version && npm run version:sync",
    "version:major": "npm version major --no-git-tag-version && npm run version:sync",
    "depcruise": "depcruise --validate .dependency-cruiser.cjs src",
    "dupcheck": "jscpd --config .jscpd.json src",
    "quality": "npm run depcruise && npm run dupcheck && eslint . && npm run format:check",
    "ci:simulate": "CI=true npm run lint && npm run format:check && npm run test:unit && npm run test:e2e",
    "semgrep": "npx semgrep --error --config p/security-audit --config p/javascript --config p/owasp-top-ten"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@eslint/js": "^9.31.0",
    "@jest/globals": "^30.0.5",
    "@playwright/test": "^1.54.1",
    "babel-plugin-istanbul": "^7.0.1",
    "depcheck": "^1.4.7",
    "dependency-cruiser": "^17.0.1",
    "eslint": "^9.31.0",
    "eslint-plugin-jest": "^28.14.0",
    "eslint-plugin-no-unsanitized": "^4.1.2",
    "eslint-plugin-playwright": "^1.8.3",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^15.15.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "jscpd": "^4.0.5",
    "lcov-result-merger": "^5.0.1",
    "lint-staged": "^16.1.2",
    "madge": "^8.0.0",
    "npm-check-updates": "^18.0.1",
    "nyc": "^17.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "tests/**/*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "scripts/**/*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "nyc": {
    "check-coverage": true,
    "per-file": true,
    "lines": 80,
    "statements": 80,
    "functions": 80,
    "branches": 80
  }
}
